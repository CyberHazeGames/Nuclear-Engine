<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>..\Bin\$(Configuration)X64\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AssemblyName>Nuclear.ScriptCore</AssemblyName>
    <RootNamespace>Nuclear</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Components\LightComponent.cs" />
    <Compile Include="Graphics\Color.cs" />
    <Compile Include="Platform\Input.cs" />
    <Compile Include="Utilities\Logger.cs" />
    <Compile Include="Components\Component.cs" />
    <Compile Include="Components\EntityInfoComponent.cs" />
    <Compile Include="ECS\Transform.cs" />
    <Compile Include="ECS\Entity.cs" />
    <Compile Include="Math\Vector2.cs" />
    <Compile Include="Math\Vector3.cs" />
    <Compile Include="Math\Vector4.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="NativeCalls.cs" />
    <ProjectReference Include="..\Nuclear.Managed\Nuclear.Managed.csproj" />
  </ItemGroup>
  <Target Name="DeployScriptingRuntime" AfterTargets="Build">
    <ItemGroup>
      <ScriptingRuntime Include="$(TargetDir)Nuclear.Managed.dll;$(TargetDir)Nuclear.Managed.runtimeconfig.json;$(TargetDir)Nuclear.Managed.deps.json;$(TargetPath);$(TargetDir)Nuclear.ScriptCore.deps.json;$(TargetDir)Nuclear.ScriptCore.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(ScriptingRuntime)" DestinationFolder="$(MSBuildProjectDirectory)\..\Samples" SkipUnchangedFiles="true" />
  </Target>
</Project>
